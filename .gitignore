# Dependencies & build output
node_modules
.next
out
next-env.d.ts
tsconfig.tsbuildinfo

# The diary itself. This is personal data — the imported records, the GPS
# coordinates derived from your theatre photos, and every image copied out of
# your Notion export. None of it belongs in version control.
data/*.db
data/*.db-shm
data/*.db-wal
public/posters/*
public/shots/*
public/people/*
!public/posters/.gitkeep
!public/shots/.gitkeep
!public/people/.gitkeep

# Source data folders, if anyone ever nests them inside the app
/d/
/src/Movies/
/src/Movies Thumbnails/
/src/Actors/
/src/Directors/

# Environment & local config
.env
.env.*
!.env.example

# Third-party agent skills, installed locally via `npx skills add`.
# Not part of the application; remove these two lines if you want them shared.
.agents/
.claude/

# OS / editor
.DS_Store
*.log
.vscode
.idea
