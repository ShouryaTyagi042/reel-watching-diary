# Copy to .env.local for development. In production set these in your host's
# environment rather than in a file.
#
# Generate the first two with:  npx tsx scripts/set-password.ts

# ---------------------------------------------------------------- admin ----

# scrypt hash of your password, in the form scrypt:N:r:p:salt:key.
# The plaintext password appears nowhere, here or anywhere else.
#
# Note the colons. Next's env loader performs shell-style variable expansion, so
# a value containing $NAME is silently replaced with whatever that variable holds
# (usually nothing). A $-separated hash arrives shredded and every login fails
# with "wrong password". Colons survive, and base64 never contains one.
ADMIN_PASSWORD_HASH=

# 32+ bytes of randomness, used to sign the session cookie.
# Keep it stable: changing it signs you out everywhere. Changing the password
# does too, deliberately, because the signing key is derived from both.
SESSION_SECRET=

# The exact origin the app is served from, no trailing slash.
# Mutating requests must carry a matching Origin header, which is what stops a
# page on another site from making your browser write to the diary.
# Never inferred from the Host header: behind a proxy that is attacker-controlled.
APP_ORIGIN=http://localhost:3000

# ----------------------------------------------------------------- data ----

# Where the SQLite database lives. Defaults to ./data/diary.db.
# In production point this at the mounted persistent volume.
# DIARY_DB=/data/diary.db

# Your artwork, headshots and screening photos. Defaults to ../src.
# In production this must also be on the persistent volume.
# ASSETS_DIR=/data/assets

# An exported collection to seed from, if you have one. Defaults to ../d.
# Only read by `npm run seed`; the running app never touches it.
# EXPORT_DIR=/data/export
